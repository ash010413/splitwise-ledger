# Copy to .env. Never commit actual credentials.
SPLITWISE_CLIENT_ID=
SPLITWISE_CLIENT_SECRET=
SPLITWISE_REDIRECT_URI=http://127.0.0.1:8000/oauth/splitwise/callback
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
APP_API_TOKEN=
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/ledger.sqlite3

# Gemini powers on-demand summaries and automatic category matching.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Auto-match unclear expenses using descriptions and the user-defined categories.
GEMINI_AUTO_CATEGORIZE=true

# Personal sheet configuration (local only; never commit a live Sheet ID).
GOOGLE_SHEET_ID=
GOOGLE_SUMMARY_TAB=

# Run the per-account daily sync worker while the backend is running.
DAILY_SYNC_ENABLED=true

# Local storage is the default. Hosted Cloud Run uses Firestore and disables the local loop.
STORAGE_BACKEND=sqlite
FIRESTORE_PROJECT=
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
MAX_ACCOUNTS=4
