# Copy to .env. Never commit actual credentials.
SPLITWISE_CLIENT_ID=
SPLITWISE_CLIENT_SECRET=
SPLITWISE_REDIRECT_URI=http://127.0.0.1:8000/oauth/splitwise/callback
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
APP_API_TOKEN=
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/ledger.sqlite3

# Gemini is used only when the app's summary button is pressed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Personal sheet configuration (local only; never commit a live Sheet ID).
GOOGLE_SHEET_ID=
GOOGLE_SUMMARY_TAB=
